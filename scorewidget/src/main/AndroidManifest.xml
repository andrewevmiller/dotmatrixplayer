<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The one permission this module has that its siblings do not.

        :app and :datawidget both answer their question from the device. A
        scoreboard cannot: the score is somewhere else by definition. Everything
        that leaves is a GET to one host, with no body and no identifier - see
        EspnClient - and everything that comes back is thrown away after the
        repaint except the last snapshot, which is cached so a tile that opens
        with no signal shows the last score it knew rather than a dash.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Alarms do not survive a reboot, so the refresh has to be re-armed. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        POST_NOTIFICATIONS.

        Declaring it here does not mean asking for it at install time - on
        Android 13+ it is always a runtime-requested permission, declaration
        or not. What declaration actually controls is whether
        ConfigActivity's requestPermissions call can succeed at all: an
        undeclared dangerous permission is auto-denied with no dialog shown,
        which is why the alert toggles could be switched on and still never
        post anything without this line. ConfigActivity still waits until the
        moment a toggle is first switched on to ask, which is the only moment
        the request has a reason the user can see, and GameAlerts still
        re-checks the grant on every post because it can be revoked
        afterwards.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        A library manifest, merged into :app.

        No <application> attributes here on purpose. icon, label, theme,
        allowBackup and the two backup-rule resources are app identity, and
        :app owns them - restating them in a library either loses the merge or
        needs a tools:replace that would silently override the app. What is
        left is the components, which is all a library has to contribute.

        The activity below therefore names its own theme, which it used to
        inherit from the <application> tag.
    -->
    <application>

        <activity
            android:name="com.dotgrid.scorewidget.ConfigActivity"
            android:exported="true"
            android:label="@string/scorewidget_score_config_title"
            android:theme="@style/Theme.DotMatrixScore"
            android:windowSoftInputMode="stateHidden|adjustResize">

            <!-- No MAIN/LAUNCHER filter any more. The combined app has one
                 launcher entry - :app SetupActivity - which links here; four
                 icons in the app drawer for one installed app is not what a
                 single package should look like. Still reached from a tap on
                 the tile and from the widget's own reconfigure entry. -->
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.dotgrid.scorewidget.ScoreWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/score_widget_info" />
        </receiver>

        <!--
            Exported because the system is the sender: BOOT_COMPLETED and
            MY_PACKAGE_REPLACED are both delivered from outside the app. Neither
            action can be forged by another app - the system holds them.
        -->
        <receiver
            android:name="com.dotgrid.scorewidget.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
