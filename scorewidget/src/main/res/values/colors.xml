<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Nothing OS reads as a monochrome system with one signal colour.
         Everything is pure black / pure white; colour is reserved for state.
         Hex values are Nothing's own, from nothing_brand_guidelines.pdf, not
         invented - see docs/BRAND_LANGUAGE.md. -->
    <color name="nt_black">#FF000000</color>
    <color name="nt_white">#FFFFFFFF</color>

    <!-- Light tile surface: off-white (#F3F0F1), per the guideline's highlight
         extreme. Previously N-Grey (#DCD7D2); moved to pure white so the
         tile reads as brightly as the system launcher around it, with
         text/foreground alpha values raised below to compensate for the
         lighter ground. config_card follows the same change for the same
         reason - tile and settings card still share one surface tone. -->
    <color name="widget_surface">#FFF3F0F1</color>

    <color name="text_primary">#FF000000</color>
    <!-- Raised from 60% (#99) to 65% (#A6) now that the surface is pure
         white rather than N-Grey - keeps secondary text reading crisp
         against the brighter ground instead of just holding its old ratio. -->
    <color name="text_secondary">#A6000000</color>
    <!-- Raised from 65% (#A6) to 80% (#CC): tertiary now sits close to
         text_primary in weight, since pure white behind it can carry much
         darker text before losing the "quietest" tier's distinction from
         secondary. Comfortably clears 4.5:1 against every surface in this
         palette, white included (contrast only increases as the ground
         gets brighter at a fixed alpha). -->
    <color name="text_tertiary">#CC000000</color>

    <color name="matrix_active">#FF000000</color>
    <color name="matrix_rail">#2E000000</color>

    <!-- N-Red, #C8102E - the brand's own primary red, not a generic Material
         one. The one signal colour on this tile: a game that is live. -->
    <color name="nt_red">#FFD71921</color>

    <!-- N-Yellow, #FFC700 - one of the three the user can pick for the signal
         colour, a step below the red "this is live" signal. Only ever one of
         the three is on the tile at a time. -->
    <color name="nt_amber">#FFFFC700</color>

    <!-- Accent grey. One step down from the card (widget_surface #F3F0F1) so
         recessed and secondary surfaces read as distinct without introducing
         a second hue - the light-mode counterpart of dark mode's nt_grey_accent.
         A surface tone, not a signal colour: nt_red stays the only accent
         that means anything. See docs/BRAND_LANGUAGE.md. -->
    <color name="nt_grey_accent">#FFE8E6E7</color>

    <!-- Off-white (#F3F0F1), per the family palette - the config
         screen's page background, distinct from the N-Grey card it frames. -->
    <color name="config_bg">#FFF3F0F1</color>
    <!-- Now identical to config_bg (both pure white) since widget_surface
         moved to white too. The card still reads as distinct from the page
         via the hairline border drawn around settings-screen cards (never
         applied to the tile itself - see widget_bg.xml/docs/BRAND_LANGUAGE.md) -
         config_field's darker recessed fill inside the card is the other
         cue that keeps the card from looking like bare page background. -->
    <color name="config_card">#FFF3F0F1</color>
    <!-- Unchanged (#FFC7C3BE) - re-verified against the new pure-white
         config_card. The step is now MORE visually distinct than before,
         since the card lightened out from under it while the field stayed
         put. Contrast for the team-picker's row text (text_secondary, now
         65%/#A6 alpha) against this field computes to ~5.5:1, still clear
         of the 4.5:1 bar - raising text_secondary's alpha only helped. -->
    <color name="config_field">#FFC7C3BE</color>
    <!-- chip_on stays white on purpose: chip_text.xml pairs the selected
         state with nt_black text, and nt_black/nt_white are brand
         invariants left unsplit (see report) - a black fill would make that
         text unreadable. -->
    <color name="chip_on">#FFFFFFFF</color>
    <!-- Raised from 8% (#14) to 12% (#1F) - reusing the same alpha as
         hairline below. At the old alpha, chip_off was nearly invisible
         against the new pure-white config_card/config_field (contrast
         ratio dropped under 1.2:1); #1F is the alpha this palette already
         trusts to read as a visible mark on a white-ish ground. -->
    <color name="chip_off">#1F000000</color>
    <!-- Decorative hairline only (settings-screen cards, never the tile -
         widget_bg.xml stays fill-only). Not a text pairing, so it isn't held
         to a contrast ratio; kept as the same low-alpha black-on-light the
         dark version uses white-on-dark, just inverted polarity. -->
    <color name="hairline">#1F000000</color>

    <!-- CTA pill button on the config screen. Inverted from the fixed
         nt_white/nt_black pairing that used to be hardcoded: on the now
         pure-white config_bg, a white pill with black text had no visible
         boundary at all, so light mode flips to a black pill with white
         text. Dark mode keeps the original white-pill/black-text look. -->
    <color name="button_surface">#FF000000</color>
    <color name="button_text">#FFFFFFFF</color>
</resources>
