<?xml version="1.0" encoding="utf-8"?>
<!--
    The 4x1 banner: 250 x 40dp on a standard launcher grid.

    The same single row as the strip with an extra 140dp of width, and that
    width buys three things in this order: the team abbreviations in type beside
    their matrices, the clock, and the sport-specific line - down and distance,
    or the count. It does not buy a second row, so anything that needs one
    (broadcast, top performer, win probability) waits for the 4x2 card.

    Every label is an ImageView - see widget_score_strip.xml and TextRenderer.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/score_widget_bg"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/banner_padding_h"
    android:paddingTop="@dimen/banner_padding_v"
    android:paddingEnd="@dimen/banner_padding_h"
    android:paddingBottom="@dimen/banner_padding_v">

    <ImageView
        android:id="@+id/away_glyph"
        android:layout_width="@dimen/banner_glyph"
        android:layout_height="@dimen/banner_glyph"
        android:contentDescription="@string/scorewidget_cd_away_team"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/away_abbrev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/banner_abbrev_gap"
        android:contentDescription="@null" />

    <!--
        The possession marker sits between the abbreviation and the score, on
        whichever side has the ball. Two views rather than one moved about,
        because RemoteViews can set a visibility far more cheaply than it can
        restate a layout, and a widget that repaints every minute during a game
        should do the cheap thing.
    -->
    <ImageView
        android:id="@+id/away_possession"
        android:layout_width="@dimen/possession_dot"
        android:layout_height="@dimen/possession_dot"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/scorewidget_cd_possession"
        android:src="@drawable/possession_dot"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/scoreline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:contentDescription="@string/scorewidget_cd_score"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/home_possession"
        android:layout_width="@dimen/possession_dot"
        android:layout_height="@dimen/possession_dot"
        android:layout_marginEnd="4dp"
        android:contentDescription="@string/scorewidget_cd_possession"
        android:src="@drawable/possession_dot"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/home_abbrev"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/banner_abbrev_gap"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/home_glyph"
        android:layout_width="@dimen/banner_glyph"
        android:layout_height="@dimen/banner_glyph"
        android:contentDescription="@string/scorewidget_cd_home_team"
        android:scaleType="fitCenter" />

    <!--
        The right-hand column: clock over context, or the countdown before a
        game, or the final over the date after one. Fixed width rather than
        wrap_content, so the two matrices and the score stay put as the clock
        ticks from "10:00" to "9:59" - a scoreline that shuffles sideways once a
        second is the thing the eye follows instead of the score.
    -->
    <LinearLayout
        android:layout_width="@dimen/banner_status_width"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/banner_status_gap"
        android:gravity="end"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/clock_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:contentDescription="@string/scorewidget_cd_clock" />

        <ImageView
            android:id="@+id/context_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:contentDescription="@null" />
    </LinearLayout>

    <!--
        The carousel control.

        A dot per card with the current one lit, and tapping it steps forward.
        This is the honest form of the "swipe carousel" in the brief: a widget
        surface receives clicks and nothing else - neither RemoteViews nor
        Glance can see a drag, because the launcher's own gesture detector owns
        horizontal movement for paging the home screen. A control that is
        visibly a pager and advances on a tap tells the truth about what it
        does; an invisible swipe target that sometimes flips the home screen
        instead would not.

        Hidden entirely when there is only one card - a pager with one dot is a
        decoration that invites a tap and does nothing.

        paddingStart widened the same way and for the same reason as the
        media widget's source_switcher: it eats into scoreline's own weighted
        space (scoreline is layout_weight=1, the only flexible sibling in
        this row), enlarging the tap target without moving or resizing the
        dots themselves.
    -->
    <ImageView
        android:id="@+id/pager"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/scorewidget_cd_next_game"
        android:paddingStart="9dp"
        android:paddingEnd="2dp"
        android:scaleType="center"
        android:visibility="gone" />
</LinearLayout>
