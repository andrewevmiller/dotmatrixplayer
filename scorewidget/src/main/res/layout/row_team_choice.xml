<?xml version="1.0" encoding="utf-8"?>
<!-- One selectable team in the picker. Tapping it appends to the queue. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/score_config_field_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="9dp"
    android:paddingEnd="14dp"
    android:paddingBottom="9dp">

    <ImageView
        android:id="@+id/choice_glyph"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/choice_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        style="@style/ScoreBody"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Drawn, to match the controls on the favourites rows. -->
    <ImageView
        android:id="@+id/choice_add"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_add" />
</LinearLayout>
