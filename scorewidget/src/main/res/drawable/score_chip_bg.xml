<?xml version="1.0" encoding="utf-8"?>
<!-- Selection is carried by fill, not by a tick: the whole system is
     monochrome, so "on" is the chip that went solid. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/chip_on" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/chip_off" />
            <corners android:radius="100dp" />
            <stroke android:width="1dp" android:color="@color/hairline" />
        </shape>
    </item>
</selector>
