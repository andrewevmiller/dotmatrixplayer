<?xml version="1.0" encoding="utf-8"?>
<!--
    Remove control.

    NType 82 does have U+00D7, so this one could have stayed a character - but
    a text glyph sitting between two drawn chevrons carries a different stroke
    weight and optical size, and the row reads as two icons and a typo. Drawn to
    match instead.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/text_secondary">
    <path
        android:pathData="M8,8 L16,16 M16,8 L8,16"
        android:strokeWidth="1.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round" />
</vector>
