<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <!-- text_primary, not nt_white: this dot sits directly on config_bg (the
         window background), which flips light/dark with the theme. A literal
         white dot would vanish against the light-mode background. -->
    <solid android:color="@color/text_primary" />
</shape>
