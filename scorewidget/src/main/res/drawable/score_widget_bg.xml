<?xml version="1.0" encoding="utf-8"?>
<!--
    Fill only, no stroke.

    Both sibling tiles ring their card in a 1dp #1FFFFFFF hairline - it is what
    separates a near-black card from a launcher wallpaper that is often also
    near-black. This tile skips it: it carries far more on the card face itself
    (two matrices, a scoreline, a rail) than either sibling, and a stroke around
    all of that reads as one more line competing with the content rather than as
    a frame for it. The near-black fill against the corner radius is doing the
    "this is a card" work on its own.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_surface" />
    <corners android:radius="26dp" />
</shape>
