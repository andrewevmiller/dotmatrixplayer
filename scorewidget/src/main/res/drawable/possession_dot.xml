<?xml version="1.0" encoding="utf-8"?>
<!-- Outline, not a fill: possession is a marker beside a name, and a solid
     dot the same weight as the live indicator would compete with it for
     which one means "this matters more". -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1.2dp" android:color="@color/text_primary" />
</shape>
