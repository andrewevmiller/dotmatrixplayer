<?xml version="1.0" encoding="utf-8"?>
<!--
    Empty-artwork state: vinyl record as the no-art placeholder.
    A solid white disc with a dark center label, mimicking a vinyl record.
    Shown whenever there is no album art to draw - no session at all, or a
    session whose app published neither an artwork bitmap nor a URI ArtworkTools
    could decode.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="72dp"
    android:height="72dp"
    android:viewportWidth="72"
    android:viewportHeight="72">

    <!-- Outer vinyl disc (white) -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M36,0 A36,36 0 1,0 36,72 A36,36 0 1,0 36,0 Z" />

    <!-- Center record label (dark) -->
    <path android:fillColor="#FF1a1a1a"
        android:pathData="M36,22 A14,14 0 1,0 36,50 A14,14 0 1,0 36,22 Z" />

    <!-- Small center spindle hole -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M36,34 A2,2 0 1,0 36,38 A2,2 0 1,0 36,34 Z" />
</vector>
