<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Nothing OS reads as a monochrome system with one signal colour.
         Everything is pure black / pure white; red is reserved for state. -->
    <color name="nt_black">#FF000000</color>
    <color name="nt_white">#FFFFFFFF</color>

    <!-- Accent grey, dark mode only. One step lighter than the tile
         (widget_surface #1B1B1D) so recessed and secondary surfaces read as
         distinct without introducing a second hue - the dark-mode counterpart
         of light mode's config_field. A surface tone, not a signal colour:
         nt_red stays the only accent that means anything. See
         docs/BRAND_LANGUAGE.md. -->
    <color name="nt_grey_accent">#FF303032</color>

    <!-- Both the tile and the setup screen now follow the system theme.
         These are the values the app has always shown - dark mode is a
         zero-regression carry-forward of what was previously the only
         look, not a new design. -->
    <color name="widget_surface">#FF1B1B1D</color>
    <color name="widget_stroke">#1FFFFFFF</color>

    <color name="text_primary">#FFFFFFFF</color>
    <color name="text_secondary">#99FFFFFF</color>
    <color name="text_tertiary">#5CFFFFFF</color>

    <color name="app_glyph">#E0FFFFFF</color>

    <!-- Unchanged from what control_ring.xml hardcoded before this was made
         a token - see values/colors.xml for why light mode needed its own
         value. -->
    <color name="control_ring_stroke">#66FFFFFF</color>

    <color name="track_active">#FFFFFFFF</color>
    <color name="track_inactive">#33FFFFFF</color>

    <!-- The one accent. Used only for "this is live".
         N-Red as used across this family: #D71921 - a deliberate departure from
         the guideline PDF's printed #C8102E, see docs/BRAND_LANGUAGE.md. -->
    <color name="nt_red">#FFD71921</color>

    <!-- Deliberately unsplit, like nt_black/nt_white: this is the "no
         artwork" swatch behind the disc glyph, not a themed surface. It
         stays a dark backdrop in both themes, same reasoning a photo mat
         stays a fixed tone regardless of the page around it - the artwork
         it's standing in for has no light/dark version either. Nothing else
         in the family reads text against it. -->
    <color name="art_placeholder">#FF141414</color>

    <color name="setup_bg">#FF000000</color>
    <color name="setup_card">#FF0E0E0E</color>

    <color name="button_surface">#FFFFFFFF</color>
    <color name="button_text">#FF000000</color>
</resources>
