    <string name="setup_headline">Dot Matrix Player</string>
    <string name="setup_body">This widget reads whichever media session is currently active and sends transport commands back to it. Android requires notification access for that — it is the only permission the app asks for, and nothing leaves the device.</string>
    <string name="setup_grant">GRANT NOTIFICATION ACCESS</string>
    <string name="setup_granted">ACCESS GRANTED</string>
    <string name="setup_add_widget">Long-press the home screen \u2192 Widgets \u2192 Dot Matrix Player \u2192 drag the 5 \u00d7 3 tile.</string>
    <string name="setup_status_on">CONNECTED</string>
    <string name="setup_status_off">NOT CONNECTED</string>
    <string name="setup_settings_missing">This device has no notification access screen. Grant it from Settings &gt; Notifications manually.</string>

    <string name="setup_idle_pref_title">Preferred app when idle</string>
    <string name="setup_idle_pref_body">When nothing is playing and more than one app has something recent to show, the widget remembers this one.</string>
