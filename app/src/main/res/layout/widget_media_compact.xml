<?xml version="1.0" encoding="utf-8"?>
<!--
    The two-cell-tall tile: 5 x 2 (320 x 110dp) down to the 4 x 2 resize floor
    (250 x 110dp). 8dp padding leaves 94dp of height, which is far too little for
    the stacked arrangement the 5 x 3 uses - so this one turns ninety degrees:
    artwork fills the height on the left, everything else stacks in a column
    beside it.

    That is also what makes the art big here. Kept in the 5 x 3's top-row
    arrangement it could only ever be as tall as one row of three; given the
    whole height it is 86dp, twice what it was.

    Same view ids as widget_media.xml so WidgetRenderer populates either without
    knowing which is live. The status label and time codes have no room at this
    size but still exist, hidden - a RemoteViews action aimed at a missing id
    throws at apply() time.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="@dimen/art_size_compact"
        android:layout_height="@dimen/art_size_compact">

        <ImageView
            android:id="@+id/art_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/art_placeholder_bg"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/art_fallback"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_art_glyph_disc" />

        <ImageView
            android:id="@+id/album_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cd_album_art"
            android:scaleType="fitXY"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/live_dot"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:contentDescription="@null"
                android:src="@drawable/live_dot" />

            <ImageView
                android:id="@+id/track_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/idle_title" />

            <!-- See widget_media.xml: FrameLayout because Space is not remotable. -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Source switcher; see widget_media.xml. Tighter here, but the
                 vertical padding still lifts the target well past the 15dp
                 mark it wraps. paddingStart widened the same way and for the
                 same reason as widget_media.xml: it eats into the row's
                 weighted spacer, not the glyph's own position. -->
            <LinearLayout
                android:id="@+id/source_switcher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:paddingStart="13dp"
                android:paddingEnd="0dp">

                <ImageView
                    android:id="@+id/source_dots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:contentDescription="@null"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/app_glyph"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginTop="4dp"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/track_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_marginTop="3dp"
            android:contentDescription="@string/idle_artist" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/progress_height_compact"
            android:layout_marginTop="7dp">

            <ImageView
                android:id="@+id/progress_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY" />

            <include layout="@layout/seek_strip" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_size_compact"
            android:layout_marginTop="5dp"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_prev"
                android:layout_width="@dimen/control_size_compact"
                android:layout_height="@dimen/control_size_compact"
                android:background="@drawable/control_ghost"
                android:contentDescription="@string/cd_previous"
                android:padding="7dp"
                android:src="@drawable/ic_prev" />

            <ImageView
                android:id="@+id/btn_play"
                android:layout_width="@dimen/control_size_compact"
                android:layout_height="@dimen/control_size_compact"
                android:layout_marginStart="26dp"
                android:layout_marginEnd="26dp"
                android:background="@drawable/control_ring"
                android:contentDescription="@string/cd_play_pause"
                android:padding="8dp"
                android:src="@drawable/ic_play" />

            <ImageView
                android:id="@+id/btn_next"
                android:layout_width="@dimen/control_size_compact"
                android:layout_height="@dimen/control_size_compact"
                android:background="@drawable/control_ghost"
                android:contentDescription="@string/cd_next"
                android:padding="7dp"
                android:src="@drawable/ic_next" />
        </LinearLayout>

        <!-- Present but hidden: the renderer sets every id unconditionally. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/status_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/time_elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
