<?xml version="1.0" encoding="utf-8"?>
<!--
    5 x 3 home-screen tile. Laid out against the grid minimum (320 x 180dp);
    12dp padding leaves 296 x 156dp of content, which the rows below consume
    exactly: 94 (artwork) + 20 (scrub) + 42 (transport). Extra height on roomier
    launchers flows into the artwork row, the only weighted one.

    Every piece of text here is an ImageView, not a TextView. A widget cannot
    set a custom font in XML - AppWidgetHostView inflates through a
    CONTEXT_RESTRICTED context, and TextView skips android:fontFamily when the
    context is restricted - so the Nothing faces are drawn to bitmaps in our own
    process by TextRenderer. Each label is wrap_content in both axes so the
    bitmap lands at exactly 1:1 with no scaling.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <!-- ROW 1 - artwork + metadata -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="@dimen/art_size"
            android:layout_height="@dimen/art_size">

            <ImageView
                android:id="@+id/art_backdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/art_placeholder_bg"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/art_fallback"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_art_glyph_disc" />

            <ImageView
                android:id="@+id/album_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_album_art"
                android:scaleType="fitXY"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/art_gap"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/live_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/live_dot" />

                <ImageView
                    android:id="@+id/status_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:contentDescription="@string/label_now_playing" />

                <!-- Weighted spacer, so the mark below sits hard against the
                     right edge. A plain <Space> would be the obvious element and
                     is not remotable; an empty FrameLayout is. -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Source switcher: the app mark, plus a dot per other app
                     holding a session. Tapping it pages to the next source.

                     One container rather than a click on the 20dp mark itself,
                     which is well under the 48dp touch minimum - the padding
                     here buys a real target without changing what is drawn.
                     Both children are hidden when there is nothing to show or
                     nowhere to page to.

                     paddingStart is wider than the mark needs on purpose: this
                     row ends in a weighted spacer (see above) that absorbs
                     whatever width isn't claimed, so growing into it here
                     enlarges the tap target leftward without moving the glyph
                     - the switcher stays flush with the row's right edge
                     either way. paddingEnd stays 0 for the same reason
                     paddingTop/Bottom are untouched: both are already flush
                     against a fixed boundary (the row's right edge; the
                     metadata column's tight 94dp vertical budget - see
                     WidgetRenderer's statusWidthPx/glyphSpacePx accounting),
                     so growing either risks colliding with or clipping a
                     sibling instead of eating dead space. -->
                <LinearLayout
                    android:id="@+id/source_switcher"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="0dp">

                    <ImageView
                        android:id="@+id/source_dots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="7dp"
                        android:contentDescription="@null"
                        android:visibility="gone" />

                    <!-- Dropped below the status baseline on purpose: at this
                         size it reads as a mark on the card rather than as
                         punctuation on the end of the label. -->
                    <ImageView
                        android:id="@+id/app_glyph"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="8dp"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/track_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/idle_title" />

            <ImageView
                android:id="@+id/track_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:contentDescription="@string/idle_artist" />
        </LinearLayout>
    </LinearLayout>

    <!-- ROW 2 - elapsed / scrubbable bar / duration -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/progress_height"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/time_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/time_zero" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/progress_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY" />

            <include layout="@layout/seek_strip" />
        </FrameLayout>

        <ImageView
            android:id="@+id/time_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/time_zero" />
    </LinearLayout>

    <!-- ROW 3 - transport -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/control_size"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_prev"
            android:layout_width="@dimen/control_size"
            android:layout_height="@dimen/control_size"
            android:background="@drawable/control_ghost"
            android:contentDescription="@string/cd_previous"
            android:padding="8dp"
            android:src="@drawable/ic_prev" />

        <ImageView
            android:id="@+id/btn_play"
            android:layout_width="@dimen/control_size"
            android:layout_height="@dimen/control_size"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:background="@drawable/control_ring"
            android:contentDescription="@string/cd_play_pause"
            android:padding="9dp"
            android:src="@drawable/ic_play" />

        <ImageView
            android:id="@+id/btn_next"
            android:layout_width="@dimen/control_size"
            android:layout_height="@dimen/control_size"
            android:background="@drawable/control_ghost"
            android:contentDescription="@string/cd_next"
            android:padding="8dp"
            android:src="@drawable/ic_next" />
    </LinearLayout>
</LinearLayout>
