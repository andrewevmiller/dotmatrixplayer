<?xml version="1.0" encoding="utf-8"?>
<!--
  Respiratory rate as a breath trace: two long shallow swells, which is what
  a respiration waveform looks like next to the sharp spikes of a heartbeat.
  Drawn as a stroke rather than a fill so it reads as a trace, not a mass.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.1"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M1.9,12
                           C4.1,12 4.1,6.2 6.3,6.2
                           C8.5,6.2 8.5,17.8 10.7,17.8
                           C12.9,17.8 12.9,6.2 15.1,6.2
                           C17.3,6.2 17.3,12 19.5,12
                           L22.1,12" />
</vector>
