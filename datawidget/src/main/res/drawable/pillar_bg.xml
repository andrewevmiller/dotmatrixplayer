<?xml version="1.0" encoding="utf-8"?>
<!--
    White fill, tinted at draw time via setColorFilter - same technique
    alert_dot.xml and widget_border.xml already use, so one shape covers
    every colour (pillar_surface normally, the chosen alert colour on trip).

    Same 26dp corner radius as widget_bg.xml: this drawable is drawn edge to
    edge over widget_root's own background (see widget_data.xml's
    pillar_card_bg), so the two have to agree on the card shape.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/white" />
    <corners android:radius="26dp" />
</shape>
