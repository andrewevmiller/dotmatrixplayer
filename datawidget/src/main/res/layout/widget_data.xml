<?xml version="1.0" encoding="utf-8"?>
<!--
    The 2 x 2 tile: 110 x 110dp on a standard launcher grid. 10dp of padding
    leaves a 90dp square, and everything lives inside it - the dial is drawn to
    fill that square and the readout sits in the dial's middle.

    Every label is an ImageView. That is not a style choice: AppWidgetHostView
    inflates through a CONTEXT_RESTRICTED context and TextView skips
    android:fontFamily when the context is restricted, so a TextView here would
    silently come out in the system face. See TextRenderer, and the
    verifyWidgetHasNoTextViews check wired into preBuild.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="@dimen/data_widget_padding">

    <!--
        The dial. fitCenter, not fitXY: the bitmap is square and a uniform scale
        keeps its dots round, so a tile that is a few pixels off the size we
        rendered for degrades into a slightly smaller dial rather than into a
        ring of ellipses.
    -->
    <ImageView
        android:id="@+id/meter"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/datawidget_cd_meter"
        android:scaleType="fitCenter" />

    <!--
        Value and unit are one bitmap, not two views: they are set at different
        sizes on a shared baseline, and RemoteViews cannot align baselines
        across ImageViews.
    -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:baselineAligned="false"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/usage_readout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/datawidget_cd_widget" />

        <ImageView
            android:id="@+id/limit_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/cycle_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:contentDescription="@null" />
    </LinearLayout>

    <!--
        Corner indicator. Sits in the gap between the dial's top right and the
        card's rounded corner - the one piece of the tile the dial does not
        already occupy.

        Hard into that corner, with no margin of its own. Set in a little, it
        lands about 6dp off the arc, and when the dial has gone red too the dot
        stops reading as an indicator and starts reading as a stray dot that
        fell off the scale. Flush to the padding it is 17dp clear, and no
        further out than the card's rounded corner allows.
    -->
    <ImageView
        android:id="@+id/alert_dot"
        android:layout_width="@dimen/alert_dot"
        android:layout_height="@dimen/alert_dot"
        android:layout_gravity="top|end"
        android:contentDescription="@string/datawidget_cd_alert"
        android:src="@drawable/alert_dot"
        android:visibility="gone" />

    <!--
        Border indicator. Drawn over the card rather than swapping the card's
        own background, so the surface and the stroke stay independent and one
        colour filter can retint it.
    -->
    <ImageView
        android:id="@+id/alert_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-10dp"
        android:layout_marginBottom="-10dp"
        android:layout_marginStart="-10dp"
        android:layout_marginEnd="-10dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_border"
        android:visibility="gone" />
</FrameLayout>
