<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The library no longer ships an APK, so this is not an app name any
         more - it is the label on the config activity, which the widget picker
         and app info show. Kept as its own string so :app owns data_app_name. -->
    <string name="datawidget_data_config_title">Data Usage</string>
    <string name="datawidget_data_widget_description">Monthly mobile data on a dot-matrix dial, with your own rollover date and over-limit indicator.</string>

    <!-- Cross-widget menu. This module cannot depend on :app or the sibling
         widget modules (see ConfigActivity#showWidgetMenu), so the media
         player's own name is duplicated here rather than referenced. -->
    <string name="datawidget_menu_media_player">Media Player</string>
    <string name="datawidget_menu_score_widget">Live Scores</string>
    <string name="datawidget_menu_health_widget">Health</string>
    <string name="datawidget_menu_content_description">Other widgets</string>
    <string name="datawidget_menu_settings_missing">That widget\'s settings screen is not part of this build.</string>

    <!-- Widget readout -->
    <string name="datawidget_limit_format">LIMIT %1$s GB</string>
    <string name="datawidget_no_limit">NO LIMIT</string>
    <string name="datawidget_days_left_format">%1$dD LEFT</string>
    <string name="datawidget_rolls_today">ROLLS TODAY</string>
    <string name="datawidget_value_unknown">--</string>
    <string name="datawidget_no_access_line">NO ACCESS</string>
    <string name="datawidget_no_access_hint">TAP TO GRANT</string>

    <string name="datawidget_cd_meter">Data usage meter</string>
    <string name="datawidget_cd_alert">Over limit</string>
    <string name="datawidget_cd_widget">Mobile data used this cycle</string>

    <!-- Configuration screen -->
    <string name="datawidget_data_config_headline">Dot Matrix Data</string>
    <string name="datawidget_data_config_body">This tile reads the mobile data your phone has counted since your plan last rolled over. Android puts that number behind usage access — it is the only permission the app asks for, and nothing leaves the device.</string>

    <string name="datawidget_config_grant">GRANT USAGE ACCESS</string>
    <string name="datawidget_config_granted">ACCESS GRANTED</string>
    <string name="datawidget_config_status_on">CONNECTED</string>
    <string name="datawidget_config_status_off">NOT CONNECTED</string>
    <string name="datawidget_config_settings_missing">This device has no usage access screen. Grant it from Settings &gt; Apps &gt; Special app access manually.</string>

    <string name="datawidget_config_section_layout">SHAPE</string>
    <string name="datawidget_config_layout_gauge">GAUGE</string>
    <string name="datawidget_config_layout_pillar">PILLAR</string>
    <string name="datawidget_config_layout_hint">The pillar is a tall dot grid for a 2 × 1 placement, with no readout text - resize the tile to match once placed.</string>

    <string name="datawidget_config_section_cycle">ROLLOVER</string>
    <string name="datawidget_config_cycle_hint">Day of the month your allowance resets. Months without that date roll over on their last day.</string>
    <string name="datawidget_config_next_reset_format">NEXT: %1$s</string>

    <string name="datawidget_config_section_limit">ALLOWANCE</string>
    <string name="datawidget_config_limit_suffix">GB</string>
    <string name="datawidget_config_limit_hint">Set 0 for no limit — the dial goes inert and the tile just counts.</string>

    <string name="datawidget_config_section_alert">OVER-LIMIT INDICATOR</string>
    <string name="datawidget_config_alert_hint">What the tile does once usage crosses the threshold.</string>
    <string name="datawidget_config_style_dot">CORNER DOT</string>
    <string name="datawidget_config_style_ring">DIAL</string>
    <string name="datawidget_config_style_value">NUMBER</string>
    <string name="datawidget_config_style_card">BORDER</string>

    <string name="datawidget_config_section_threshold">TRIPS AT</string>
    <string name="datawidget_config_threshold_format">%1$d%%</string>
    <string name="datawidget_config_threshold_hint">Share of the allowance that turns the indicator on. Below 100 warns early; above 100 gives you some overdraft.</string>

    <string name="datawidget_config_section_color">COLOUR</string>
    <string name="datawidget_config_color_red">RED</string>
    <string name="datawidget_config_color_amber">YELLOW</string>
    <string name="datawidget_config_color_white">WHITE</string>

    <string name="datawidget_config_done">DONE</string>
    <string name="datawidget_config_add_widget">Long-press the home screen → Widgets → Dot Matrix Data → drag the 2 × 2 tile.</string>

    <string name="datawidget_cd_decrease">Decrease</string>
    <string name="datawidget_cd_increase">Increase</string>

    <!-- The stepper keys. An ASCII hyphen, not a true minus: in Ndot 57
         Aligned the plus is a 3 x 3 dot glyph and the hyphen is exactly its
         crossbar, where U+2212 is five dots wide and reads as an ellipsis. -->
    <string name="datawidget_stepper_minus">-</string>
    <string name="datawidget_stepper_plus">+</string>
    <string name="datawidget_limit_hint_zero">0</string>
</resources>
